# /etc/mesh-deadrop.env — read by mesh-deadrop.service. No secrets needed by default.

# meshbus + heartbeat broker (OpenTAKServer's RabbitMQ MQTT on the Pi). Keep guest on the Pi;
# off the Pi use MQTT_HOST=isr-pi.local with the isrkit user (guest is loopback-only).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest

WEB_PORT=8070
DEADROP_DB=/var/lib/mesh-deadrop/messages.db

# Extra arguments, e.g. --simulate, or --serial /dev/ttyUSB0 (standalone, only without mesh-bridge)
DEADROP_ARGS=

# Heartbeat on isrkit/heartbeat/mesh-deadrop every 10 s (HEARTBEAT=0 disables; PUBLIC_URL overrides the URL)
HEARTBEAT=1
